create table if not EXISTS loan(
    userId numeric(10) not null,
    watchId numeric(10) not null,
    loanDate date default (CURRENT_DATE),
    returnLoanDate date not null,
    isOutDelay boolean,
    primary key (userId, watchId)
)engine=innodb;

